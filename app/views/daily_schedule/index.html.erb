<% content_for :title, "1日のスケジュール" %>
<% today = Time.zone.today %>
<% now = Time.current %>
<% day_label = "#{@date.month}/#{@date.day}（#{DailyScheduleTask::WEEKDAY_NAMES[@date.wday]}）" %>
<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
  <h1 class="page-title">1日のスケジュール</h1>
  <nav class="flex items-center gap-2 ml-auto" aria-label="日付の切り替え">
    <%= link_to "‹", daily_schedule_path_for(@date - 1), class: "btn-secondary btn-sm", aria: { label: "前の日" } %>
    <%= form_with url: daily_schedule_path, method: :get, local: true, id: "daily-date-form", class: "relative", data: { controller: "date-jump", date_jump_selected_value: @date.iso8601, date_jump_today_value: today.iso8601, action: "keydown->date-jump#keydown" } do %>
      <button type="button" id="daily-date" class="inline-flex items-center gap-2 min-h-11 text-[19px] font-bold tnum min-w-[7.5em] justify-center cursor-pointer rounded-field border border-line px-3 py-1 hover:bg-bg" aria-label="<%= day_label %>（日付を選ぶ）" aria-haspopup="dialog" aria-expanded="false" data-date-jump-target="button" data-action="date-jump#toggle">
        <svg aria-hidden="true" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        <span><%= day_label %></span>
      </button>
      <input type="hidden" name="date" value="<%= @date.iso8601 %>" data-date-jump-target="input">
      <div hidden role="dialog" aria-label="日付を選ぶ" data-date-jump-target="panel" class="absolute right-0 top-full mt-2 z-30 w-[22rem] max-w-[90vw] rounded-field border border-line bg-white p-3 shadow-lg">
        <div class="flex items-center justify-between gap-2 mb-2">
          <button type="button" class="btn-secondary btn-sm min-h-11 min-w-11" aria-label="前の月" data-action="date-jump#prevMonth">‹</button>
          <span class="text-base font-bold" aria-live="polite" data-date-jump-target="title"></span>
          <button type="button" class="btn-secondary btn-sm min-h-11 min-w-11" aria-label="次の月" data-action="date-jump#nextMonth">›</button>
        </div>
        <div class="grid grid-cols-7 text-center text-base text-text-sub" aria-hidden="true">
          <% DailyScheduleTask::WEEKDAY_NAMES.each do |w| %><span><%= w %></span><% end %>
        </div>
        <div class="grid grid-cols-7 text-center" data-date-jump-target="grid"></div>
      </div>
    <% end %>
    <%= link_to "›", daily_schedule_path_for(@date + 1), class: "btn-secondary btn-sm", aria: { label: "次の日" } %>
    <%= link_to "今日", daily_schedule_path_for(today), class: "btn-secondary btn-sm" %>
  </nav>
  <%= link_to "タスクを追加", daily_schedule_path_for(@date, new: 1), class: "btn-primary" %>
</div>

<div class="grid grid-cols-1 min-[1200px]:grid-cols-[minmax(0,1fr)_400px] gap-6 items-start">
  <section id="timeline" class="card !px-6 min-w-0" aria-label="タイムライン">
    <%= render "daily_schedule/annual", annual: @annual if @annual && (@annual.error || @annual.untimed.any?) %>
    <%# タスクと、時刻つきの年間予定・送迎を、時刻順に混ぜる（同時刻はタスク→年間→送迎の順。すべて出す） %>
    <% entries = @tasks.map { |task| [ task.scheduled_at_on(@date), 0, task ] } + (@annual && !@annual.error ? @annual.timed : []).map { |event| [ event.starts_at(@date), 1, event ] } + (@pickups || []).map { |pickup| [ pickup.starts_at(@date), 2, pickup ] } %>
    <% entries = entries.each_with_index.sort_by { |(at, rank, _), i| [ at, rank, i ] }.map(&:first) %>
    <% if entries.empty? %>
      <div class="py-10 text-center">
        <p class="text-[19px] font-bold mb-4"><%= @date == today ? "今日" : "この日" %>のタスクはありません</p>
        <%= link_to "タスクを追加", daily_schedule_path_for(@date, new: 1), class: "btn-secondary" %>
      </div>
    <% else %>
      <% now_line_done = (@date != today) %>
      <ol class="divide-y divide-row-line">
        <% entries.each do |at, _rank, item| %>
          <% if !now_line_done && at > now %>
            <% now_line_done = true %>
            <li id="now-line" class="flex items-center gap-3 py-2 text-primary font-bold tnum" aria-label="現在時刻 <%= now.strftime("%H:%M") %>">
              <span>いま <%= now.strftime("%H:%M") %></span><span class="flex-1 h-0.5 bg-primary rounded-full" aria-hidden="true"></span>
            </li>
          <% end %>
          <% if item.is_a?(AnnualSchedule::Event) %>
            <%= render "daily_schedule/annual_row", event: item, date: @date, now: now %>
          <% elsif item.is_a?(ApprovedPickups::Pickup) %>
            <%= render "daily_schedule/pickup_row", pickup: item %>
          <% else %>
            <%= render "daily_schedule/row", task: item, at: at, execution: @executions[item.id], now: now %>
          <% end %>
        <% end %>
        <% unless now_line_done %>
          <li id="now-line" class="flex items-center gap-3 py-2 text-primary font-bold tnum" aria-label="現在時刻 <%= now.strftime("%H:%M") %>">
            <span>いま <%= now.strftime("%H:%M") %></span><span class="flex-1 h-0.5 bg-primary rounded-full" aria-hidden="true"></span>
          </li>
        <% end %>
      </ol>
    <% end %>
  </section>

  <% if @selected %>
    <%= render "daily_schedule/detail", task: @selected, date: @date, execution: @executions[@selected.id] %>
  <% end %>
</div>

<% if @form_task %>
  <%= render "daily_schedule/form", task: @form_task, stations: @stations, date: @date, error: @form_error %>
<% end %>
