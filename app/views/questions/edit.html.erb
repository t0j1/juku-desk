<% content_for :title, "問題の編集" %>
<div class="flex flex-wrap items-center gap-3 mb-6">
  <h1 class="font-bold text-[22px] mr-auto">問題の編集 #<%= @question.id %></h1>
  <%= link_to "一覧に戻る", questions_path, class: "btn-secondary" %>
</div>
<div class="flex flex-col gap-6 lg:flex-row">
  <div class="lg:basis-1/2">
    <img src="<%= image_crop_region_path(@question.region) %>" alt="切り出した画像" class="max-w-full h-auto rounded-xl border border-line">
    <p class="mt-2 text-xs text-ink-sub">AI の自信：<%= (@question.raw_ai.dig("response", "confidence").to_f * 100).round %>%<% if @question.region.needs_review? %>・科目を確認してください<% end %></p>
  </div>
  <%= form_with model: @question, url: question_path(@question), method: :patch, class: "space-y-4 lg:basis-1/2" do |f| %>
    <% if @question.errors.any? %>
      <div id="error_explanation" class="py-2 px-3 bg-ng-bg text-ng rounded-lg"><ul><% @question.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
    <% end %>
    <div><%= f.label :subject, "科目", class: "block text-sm" %><%= f.select :subject, Question::SUBJECTS, { include_blank: "要確認（未選択）" }, class: "input mt-1" %></div>
    <div><%= f.label :question_type, "形式（英語のみ）", class: "block text-sm" %><%= f.select :question_type, Question::TYPE_LABELS.invert, { include_blank: "なし" }, class: "input mt-1 !w-60" %></div>
    <div><%= f.label :payload_text, "形式ごとのデータ（JSON）", class: "block text-sm" %><%= f.text_area :payload_text, value: @question.payload_text, rows: 6, class: "input mt-1 !h-auto font-mono text-sm" %>
      <p class="mt-1 text-xs text-ink-sub">並べ替え：ja, words, prefix, suffix, extra_count ／ 和訳：source ／ 英作文：ja, template（空所は ___）, blank_count ／ 長文：body（下線は &lt;u&gt;）, sub_questions（prompt, answer）／ 空所補充：body, blank_count</p></div>
    <div><%= f.label :question_text, "問題文", class: "block text-sm" %><%= f.text_area :question_text, rows: 4, class: "input mt-1 !h-auto" %></div>
    <div><%= f.label :options_text, "選択肢（1 行に 1 つ。記述式なら空）", class: "block text-sm" %><%= f.text_area :options_text, value: @question.options_text, rows: 4, class: "input mt-1 !h-auto" %></div>
    <div><%= f.label :answer_text, "解答", class: "block text-sm" %><% if @question.ai_answer? %> <span id="ai-answer" class="text-xs font-bold text-ng">AI作成（教材に解答がありませんでした。確認してから承認してください）</span><% end %><%= f.text_field :answer_text, class: "input mt-1" %></div>
    <div><%= f.label :explanation, "解説", class: "block text-sm" %><%= f.text_area :explanation, rows: 3, class: "input mt-1 !h-auto" %></div>
    <div><%= f.label :tags_text, "タグ（スペースかカンマ区切り）", class: "block text-sm" %><%= f.text_field :tags_text, value: @question.tags_text, class: "input mt-1" %></div>
    <div><%= f.label :difficulty, "難易度（1〜5・任意）", class: "block text-sm" %><%= f.select :difficulty, (1..5).to_a, { include_blank: "未設定" }, class: "input mt-1 !w-40" %></div>
    <p class="text-xs text-ink-sub">保存すると承認は外れます。内容を確認したら、一覧で「承認」してください。</p>
    <% if current_user.can_write? %><%= f.submit "保存", class: "btn-primary cursor-pointer" %><% end %>
  <% end %>
</div>
