<div class="mx-auto max-w-md">
  <h1 class="font-bold text-2xl mb-2">初期パスワードの設定</h1>
  <p class="text-lg text-text-sub mb-6"><%= @user.name %> さん（<%= @user.email_address %>）。12文字以上で、英字と数字を含めてください。</p>
  <%= form_with url: invitation_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
    <div><%= form.label :password, "パスワード", class: "label" %><%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: "input mt-1" %></div>
    <div><%= form.label :password_confirmation, "パスワード（確認）", class: "label" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input mt-1" %></div>
    <%= form.submit "設定する", class: "btn-primary cursor-pointer" %>
  <% end %>
</div>
