<div class="mx-auto max-w-md">
  <h1 class="page-title mb-6">ログイン</h1>
  <%= form_with url: session_url, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "メールアドレス", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input max-w-none" %>
    </div>
    <div>
      <%= form.label :password, "パスワード", class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input max-w-none" %>
    </div>
    <%= form.submit "ログイン", class: "btn-primary" %>
    <p><%= link_to "パスワードを忘れた場合", new_password_path, class: "link" %></p>
  <% end %>
</div>
