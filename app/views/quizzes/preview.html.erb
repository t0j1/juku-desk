<% content_for :title, "小テスト作成" %>
<% content_for :head do %>
  <style>@page { size: A4 portrait; margin: 15mm; }</style>
<% end %>
<h1 class="page-title mb-6 print:hidden">小テスト作成</h1>
<%= render "quizzes/steps", current: 3 %>
<div data-controller="print">
<div id="print-toolbar" class="card !py-4 flex flex-wrap items-center gap-x-4 gap-y-3 mb-6 print:hidden">
  <div class="flex items-center gap-2">
    <%= label_tag :print_kind, "印刷する内容", class: "label !mb-0 whitespace-nowrap" %>
    <%= select_tag :print_kind, options_for_select([ [ "問題のみ", "question" ], [ "解答のみ", "answer" ], [ "問題と解答", "both" ] ], "question"),
          class: "input !w-auto", data: { print_target: "kind", action: "change->print#choose" } %>
  </div>
  <button type="button" class="btn-primary" data-action="print#print"><%= console_icon(:printer) %>印刷</button>
  <%= form_with url: quizzes_path, method: :post, scope: :quiz, data: { turbo: false } do |f| %>
    <%= hidden_field_tag "quiz[wordbook_id]", @wordbook.id %>
    <%= f.hidden_field :start_no, value: @quiz.start_no %>
    <%= f.hidden_field :end_no, value: @quiz.end_no %>
    <%= f.hidden_field :count, value: @quiz.count %>
    <%= f.button "問題を入れ替える", type: "submit", class: "btn-secondary" %>
  <% end %>
  <%= link_to "範囲を変更", new_quiz_path(wordbook_id: @wordbook.id, start_no: @quiz.start_no, end_no: @quiz.end_no, span: @quiz.span, count: @quiz.count), class: "btn-secondary" %>
  <span class="ml-auto caption tnum whitespace-nowrap">左 <%= @left %>／右 <%= @right %></span>
</div>
<div data-print-target="sheets" data-mode="question">
  <div class="sheet-frame" data-print-target="sheet" data-kind="question">
    <%= render "quizzes/sheet", quiz: @quiz, words: @words, left: @left, kind: :question %>
  </div>
  <div class="sheet-frame" data-print-target="sheet" data-kind="answer" hidden>
    <%= render "quizzes/sheet", quiz: @quiz, words: @words, left: @left, kind: :answer %>
  </div>
</div>
</div>
