<% content_for :title, "小テスト作成" %>
<% content_for :head do %>
  <style>@page { size: A4 portrait; margin: 15mm; }</style>
<% end %>
<h1 class="font-bold text-[22px] mb-6 print:hidden">小テスト作成</h1>
<%= render "quizzes/steps", current: 3 %>
<div class="flex items-center gap-4 mb-6 print:hidden" data-controller="print">
  <button type="button" class="btn-primary !h-12 min-w-32" data-action="print#print"><%= console_icon(:printer) %>印刷</button>
  <%= form_with url: quizzes_path, method: :post, scope: :quiz, data: { turbo: false } do |f| %>
    <%= hidden_field_tag "quiz[wordbook_id]", @wordbook.id %>
    <%= f.hidden_field :start_no, value: @quiz.start_no %>
    <%= f.hidden_field :end_no, value: @quiz.end_no %>
    <%= f.hidden_field :count, value: @quiz.count %>
    <%= f.button "問題を入れ替える", type: "submit", class: "inline-flex items-center h-12 px-4 text-primary font-bold cursor-pointer hover:underline" %>
  <% end %>
  <%= link_to "範囲を変更", new_quiz_path(wordbook_id: @wordbook.id), class: "inline-flex items-center h-12 px-4 text-ink-sub font-bold hover:underline" %>
  <span class="ml-auto text-sm text-ink-sub tnum">左 <%= @left %>／右 <%= @right %></span>
</div>
<div class="sheet-frame">
  <%= render "quizzes/sheet", quiz: @quiz, words: @words, left: @left %>
</div>
