<%# current: 1..3。完了は ✓、現在は primary の塗り。色だけに頼らず番号・✓・文字で示す %>
<% labels = [ "単語帳", "範囲と問題数", "印刷" ] %>
<ol class="flex items-center gap-2 mb-8 print:hidden" aria-label="小テスト作成の手順">
  <% labels.each_with_index do |label, i| %>
    <% n = i + 1 %>
    <% state = n < current ? :done : (n == current ? :current : :todo) %>
    <li class="flex items-center gap-2" <%= tag.attributes(aria: { current: (state == :current ? "step" : nil) }) %>>
      <span class="inline-flex items-center gap-2 h-10 px-4 rounded-full text-lg font-bold <%= { current: 'bg-primary text-white', done: 'bg-bg border border-primary text-primary', todo: 'bg-bg border border-field-border text-text-sub' }[state] %>">
        <% if state == :done %><%= console_icon(:check, size: 16) %><span class="sr-only">完了:</span><% else %><span class="tnum"><%= n %></span><% end %>
        <%= label %>
      </span>
      <% if n < labels.size %><span class="text-text-sub" aria-hidden="true">→</span><% end %>
    </li>
  <% end %>
</ol>
