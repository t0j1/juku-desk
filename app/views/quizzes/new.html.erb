<% content_for :title, "小テスト作成" %>
<div class="flex flex-wrap items-center gap-3 mb-6">
  <h1 class="font-bold text-[22px] mr-auto">小テスト作成</h1>
  <%= link_to "マーキング問題から出題", new_marking_test_path, class: "btn-secondary" %>
</div>
<% if @wordbook %>
  <%= render "quizzes/steps", current: 2 %>
  <%= render "quizzes/range_form", quiz: @quiz %>
<% else %>
  <%= render "quizzes/steps", current: 1 %>
  <%= render "quizzes/wordbook_form", wordbooks: @wordbooks %>
<% end %>
