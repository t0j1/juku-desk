<%# A4 縦・余白15mm（@page）。モノクロ印刷で読めるよう、色は使わず罫線だけで構成する。
    kind: :question（記入欄は空）/ :answer（記入欄に意味を入れる）。番号は単語帳の見出し番号 %>
<% rows = left %>
<section class="sheet" id="quiz-sheet-<%= kind %>" aria-label="<%= kind == :answer ? '解答用紙' : '問題用紙' %>">
  <header class="sheet-head">
    <h2 class="sheet-title"><%= quiz.title %><%= "　解答" if kind == :answer %></h2>
    <div class="sheet-meta">
      <span>日付　　　　年　　月　　日</span>
      <span>名前 <span class="sheet-line" style="width: 48mm"></span></span>
      <span>点数 <span class="sheet-line" style="width: 14mm"></span> ／<%= quiz.count %></span>
    </div>
  </header>
  <div class="sheet-body" style="--rows: <%= rows %>">
    <% words.each_slice(rows) do |column| %>
      <div class="sheet-col">
        <% column.each do |word| %>
          <div class="sheet-row">
            <span class="sheet-no tnum"><%= word.number %>.</span>
            <span class="sheet-term"><%= word.term %></span>
            <span class="sheet-blank"><% if kind == :answer %><span class="sheet-answer"><%= word.short_meaning %></span><% end %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
