<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Juku Desk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Juku Desk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# public/ は1年キャッシュされるため、アイコンを差し替えたら ?v= の数字を上げる %>
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48">
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-bg text-text font-sans text-[15px]">
    <% if authenticated? %>
      <% if impersonating? %>
        <%= render "shared/impersonation_banner" %>
        <div class="h-12 print:hidden" aria-hidden="true"></div>
      <% end %>
      <div class="flex <%= content_for?(:embed) ? (impersonating? ? "h-[calc(100vh-3rem)] h-[calc(100dvh-3rem)]" : "h-screen h-dvh") : "min-h-screen" %> flex-col gap-3 p-3 md:flex-row md:gap-4 md:p-4 lg:gap-6 lg:p-6 print:block print:p-0 print:min-h-0" data-controller="sidebar">
        <%# 768px 未満：ヘッダーの ☰ でサイドバーを開閉する %>
        <header class="md:hidden flex items-center gap-3 print:hidden">
          <button type="button" id="sidebar-toggle" data-sidebar-target="button" data-action="sidebar#toggle" aria-controls="app-sidebar" aria-expanded="false"
                  class="inline-flex items-center justify-center size-12 rounded-button bg-bg shadow-raise-sm text-text cursor-pointer" aria-label="メニューを開く">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <span class="font-bold text-text">塾日報ステーション</span>
        </header>
        <div data-sidebar-target="scrim" data-action="click->sidebar#close" class="hidden fixed inset-0 z-30 bg-black/40 md:hidden print:hidden" aria-hidden="true"></div>
        <%= render "shared/sidebar" %>
        <main class="flex-1 min-w-0 flex flex-col <%= content_for?(:embed) ? "min-h-0 overflow-hidden rounded-card shadow-raise" : "gap-7" %> print:block print:p-0 print:shadow-none print:rounded-none">
          <%= render "shared/gemini_quota_banner" %>
          <%= render "shared/announcements" %>
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main class="card mx-auto max-w-xl mt-16">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
