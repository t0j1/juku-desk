<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Juku Desk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Juku Desk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gradient-to-b from-console-bg-from to-console-bg-to text-ink font-sans text-[15px]">
    <% if authenticated? %>
      <div class="flex min-h-screen gap-6 p-6">
        <aside class="w-[300px] shrink-0 flex flex-col">
          <%= link_to root_path, class: "flex items-center gap-3 px-2 mb-8" do %>
            <span class="flex items-center justify-center size-11 rounded-xl bg-gradient-to-br from-primary to-primary-to text-white text-xl font-bold" aria-hidden="true">塾</span>
            <span class="leading-tight"><span class="block font-bold text-ink">塾日報ステーション</span><span class="block text-xs text-ink-sub">Admin Console</span></span>
          <% end %>
          <nav aria-label="メインメニュー" class="space-y-1">
            <%= nav_item "生徒データベース", students_path, :users, active: controller_path == "students" %>
            <%= nav_item "PDF分割", tools_pdf_splitter_jobs_path, :scissors, active: controller_path.start_with?("tools/pdf_splitter") && action_name != "print" %>
            <%= nav_item "印刷", print_library_path, :printer, active: controller_path == "print_library" || (controller_path == "tools/pdf_splitter/jobs" && action_name == "print") %>
          </nav>
          <div class="mt-auto rounded-xl bg-white/70 border border-line p-4">
            <p class="font-bold text-sm text-ink"><%= current_user.name %></p>
            <p class="text-xs text-ink-sub mb-3"><%= t("roles.#{current_user.role}") %></p>
            <%= button_to session_path, method: :delete, class: "inline-flex items-center gap-2 text-sm text-ink-sub hover:text-ink cursor-pointer" do %>
              <%= console_icon(:logout, size: 16) %>ログアウト
            <% end %>
          </div>
        </aside>
        <main class="flex-1 min-w-0 bg-white rounded-[20px] shadow-card p-8">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main class="mx-auto max-w-xl mt-16 bg-white rounded-[20px] shadow-card p-8">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
