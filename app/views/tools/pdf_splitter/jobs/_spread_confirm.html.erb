<%# 見開き（横長）ページを分けるかの確認 %>
<section id="spread-confirm" class="mb-6 rounded-lg border border-warn-line bg-warn-bg p-5 text-warn-ink">
  <p class="font-bold text-base mb-1">見開きページが<%= job.spread_pages.size %>ページあります。1ページずつに分けますか？</p>
  <p class="text-sm mb-4">分けると、回の区切りを見開きの真ん中にも置けます。印刷するときは元の見開き（B4など）に戻せます。</p>
  <%= form_with url: spreads_tools_pdf_splitter_job_path(job), method: :post do |f| %>
    <fieldset class="mb-4">
      <legend class="text-sm font-bold mb-2">綴じ方向</legend>
      <div class="flex flex-wrap gap-3">
        <% { "left" => %w[1 2], "right" => %w[2 1] }.each do |b, order| %>
          <label class="flex items-center gap-3 rounded-lg border border-line-strong bg-white px-4 py-3 cursor-pointer text-ink has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary">
            <%= radio_button_tag :binding, b, job.binding == b, class: "size-4 accent-primary" %>
            <span class="flex border border-ink-sub rounded-sm overflow-hidden text-xs font-bold tnum" aria-hidden="true">
              <span class="w-7 h-9 flex items-center justify-center border-r border-dashed border-ink-sub"><%= order[0] %></span>
              <span class="w-7 h-9 flex items-center justify-center"><%= order[1] %></span>
            </span>
            <span class="text-sm"><span class="block font-bold"><%= PdfSplitJob::BINDINGS[b] %></span><span class="text-xs text-ink-sub">読む順：<%= b == "left" ? "左 → 右" : "右 → 左" %>（1→2）</span></span>
          </label>
        <% end %>
      </div>
    </fieldset>
    <div class="flex flex-wrap gap-3">
      <%= f.button "分ける", name: "decision", value: "split", class: "btn-primary" %>
      <%= f.button "分けない", name: "decision", value: "keep", class: "btn-secondary h-11 px-5 text-[15px]" %>
    </div>
  <% end %>
</section>
