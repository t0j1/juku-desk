<% content_for :title, "ユーザーの一括登録" %>
<h1 class="font-bold text-[22px] mb-4">ユーザーの一括登録（CSV）</h1>
<% if alert %><p id="alert" class="mb-4 text-sm font-bold text-ng"><%= alert %></p><% end %>
<p class="mb-2 text-sm">UTF-8 の CSV。1行目はヘッダーです。<code>email_address,name,role</code>（role は staff / viewer / system_admin。省略すると staff）。500行まで。</p>
<p class="mb-6 text-sm text-ink-sub">この画面ではまだ登録しません。次の画面でプレビューを確認してから取り込みます。</p>
<%= form_with url: admin_user_import_path, multipart: true, class: "space-y-4 max-w-md" do |f| %>
  <%= f.file_field :file, accept: ".csv,text/csv", required: true, "aria-label": "CSVファイル" %>
  <%= f.submit "プレビュー", class: "btn-primary cursor-pointer" %>
<% end %>
