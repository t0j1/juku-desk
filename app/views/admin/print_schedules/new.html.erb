<% content_for :title, "定例印刷の雛形を登録" %>
<h1 class="page-title mb-6">定例印刷の雛形を登録</h1>
<% if @stations.empty? %>
  <p class="card max-w-xl">先に<%= link_to "印刷ステーションを登録", new_admin_print_station_path, class: "link" %>してください。</p>
<% else %>
  <%= form_with model: [ :admin, @schedule ], multipart: true, class: "card max-w-xl space-y-4" do |f| %>
    <% if @error %><div id="error_explanation" class="alert-err" role="alert"><%= @error %></div><% end %>
    <div><%= f.label :name, "名前（印刷ジョブの名前になります）", class: "label" %><%= f.text_field :name, maxlength: PrintJob::TITLE_MAX, class: "input mt-1" %></div>
    <div><%= f.label :pdf, "PDF ファイル（30MBまで）", class: "label" %><span class="flex items-center min-h-11 mt-1"><%= file_field_tag "print_schedule[pdf]", id: "print_schedule_pdf", accept: "application/pdf", class: "block" %></span></div>
    <div><%= f.label :print_station_id, "ステーション", class: "label" %>
      <%= f.select :print_station_id, @stations.map { |s| [ s.name, s.id ] }, {}, class: "input mt-1 !w-auto" %></div>
    <fieldset><legend class="label">曜日</legend>
      <div class="flex flex-wrap gap-3 mt-1">
        <% PrintSchedule::WEEKDAY_NAMES.each_with_index do |name, i| %>
          <label class="flex items-center gap-1 min-h-11"><%= check_box_tag "print_schedule[weekdays][]", i, @schedule.weekdays.include?(i), id: "print_schedule_weekdays_#{i}", class: "size-5 accent-primary" %><%= name %></label>
        <% end %>
      </div></fieldset>
    <div><%= f.label :time_of_day, "印刷する時刻（HH:MM）", class: "label" %><%= f.time_field :time_of_day, class: "input mt-1 !w-auto" %></div>
    <div><%= f.label :copies, "部数", class: "label" %><%= f.number_field :copies, min: 1, max: 99, class: "input mt-1 !w-24" %></div>
    <div><label class="flex items-center gap-2 min-h-11"><%= f.check_box :collate, class: "size-5 accent-primary" %>1 部ずつまとめる（部単位）</label></div>
    <div><%= f.label :staple, "ホチキス（表示用）", class: "label" %><%= f.select :staple, PrintJobsHelper::STAPLES, {}, class: "input mt-1 !w-auto" %></div>
    <div><%= f.label :driver_preset, "ドライバーの印刷設定の名前", class: "label" %><%= f.text_field :driver_preset, maxlength: 100, class: "input mt-1" %></div>
    <%= f.submit "登録する", class: "btn-primary cursor-pointer" %>
  <% end %>
<% end %>
