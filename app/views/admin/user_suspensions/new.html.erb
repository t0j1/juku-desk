<% content_for :title, "ユーザーの一括停止" %>
<h1 class="font-bold text-[22px] mb-4">ユーザーの一括停止（CSV）</h1>
<% if alert %><p id="alert" class="mb-4 text-sm font-bold text-ng"><%= alert %></p><% end %>
<p class="mb-2 text-sm">UTF-8 の CSV。<code>email_address</code> 列がある CSV、または1行に1つのメールアドレスを並べたファイル。500行まで。</p>
<p class="mb-6 text-sm text-ink-sub">停止すると、そのユーザーはログインできなくなり、ログイン中のセッションもすべて切断されます。この画面ではまだ停止しません。</p>
<%= form_with url: admin_user_suspension_path, multipart: true, class: "space-y-4 max-w-md" do |f| %>
  <%= f.file_field :file, accept: ".csv,text/csv,text/plain", required: true, "aria-label": "CSVファイル" %>
  <%= f.submit "プレビュー", class: "btn-primary cursor-pointer" %>
<% end %>
