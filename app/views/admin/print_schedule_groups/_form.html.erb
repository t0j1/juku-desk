<%= form_with model: group, url: url, scope: :print_schedule_group, class: "space-y-4 max-w-2xl" do |f| %>
  <div><%= f.label :name, "セットの名前", class: "label" %><%= f.text_field :name, maxlength: PrintJob::TITLE_MAX, class: "input mt-1" %></div>
  <div><%= f.label :print_station_id, "ステーション", class: "label" %>
    <%= f.select :print_station_id, @stations.map { |s| [ s.name, s.id ] }, { selected: group.print_station_id }, class: "input mt-1 !w-auto" %></div>
  <fieldset><legend class="label">曜日</legend>
    <div class="flex flex-wrap gap-3 mt-1">
      <% PrintSchedule::WEEKDAY_NAMES.each_with_index do |name, i| %>
        <label class="flex items-center gap-1 min-h-11"><%= check_box_tag "print_schedule_group[weekdays][]", i, group.weekdays.include?(i), id: "print_schedule_group_weekdays_#{i}", class: "size-5 accent-primary" %><%= name %></label>
      <% end %>
    </div></fieldset>
  <div><%= f.label :start_time, "開始時刻（HH:MM）", class: "label" %><%= f.time_field :start_time, class: "input mt-1 !w-auto" %></div>
  <div><%= f.label :interval_minutes, "ジョブの間隔（分）", class: "label" %><%= f.number_field :interval_minutes, min: 1, max: 120, class: "input mt-1 !w-24" %>
    <p class="caption mt-1">セットの中の雛形を、開始時刻から順にこの間隔ずつずらして刷ります。</p></div>
  <div><label class="flex items-center gap-2 min-h-11"><%= f.check_box :active, class: "size-5 accent-primary" %>有効にする</label></div>
  <%= f.submit "保存", class: "btn-primary cursor-pointer" %>
<% end %>
