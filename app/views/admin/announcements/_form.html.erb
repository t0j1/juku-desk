<%= form_with model: [ :admin, announcement ], class: "space-y-4 max-w-xl" do |f| %>
  <% if announcement.errors.any? %>
    <div id="error_explanation" class="py-2 px-3 bg-err-bg text-err-fg rounded-lg"><ul><% announcement.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>
  <div><%= f.label :title, "タイトル（100文字まで）", class: "label" %><%= f.text_field :title, required: true, maxlength: 100, class: "input mt-1" %></div>
  <div><%= f.label :body, "本文（任意・2000文字まで）", class: "label" %><%= f.text_area :body, rows: 5, maxlength: 2000, class: "block w-full max-w-[480px] rounded-lg border border-field-border bg-bg px-3 py-2 mt-1" %></div>
  <div><%= f.label :starts_at, "表示開始", class: "label" %><%= f.datetime_field :starts_at, required: true, class: "input mt-1 !w-auto" %></div>
  <div><%= f.label :ends_at, "表示終了", class: "label" %><%= f.datetime_field :ends_at, required: true, class: "input mt-1 !w-auto" %></div>
  <%= f.submit class: "btn-primary cursor-pointer" %>
<% end %>
