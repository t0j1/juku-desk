<% content_for :title, "ステーションを登録" %>
<h1 class="page-title mb-6">ステーションを登録</h1>
<%= form_with model: [ :admin, @station ], class: "space-y-4 max-w-xl" do |f| %>
  <% if @station.errors.any? %>
    <div id="error_explanation" class="py-2 px-3 bg-err-bg text-err-fg rounded-lg"><ul><% @station.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>
  <div><%= f.label :name, "名前（教室PCの呼び名・60文字まで）", class: "label" %><%= f.text_field :name, required: true, maxlength: 60, class: "input mt-1" %></div>
  <%= f.submit "登録する", class: "btn-primary cursor-pointer" %>
<% end %>
