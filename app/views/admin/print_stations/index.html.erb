<% content_for :title, "印刷ステーション" %>
<div class="flex items-center mb-6">
  <h1 class="page-title">印刷ステーション</h1>
  <%= link_to "ステーションを登録", new_admin_print_station_path, class: "btn-primary ml-auto" %>
</div>
<% if notice %><p id="notice" class="alert-ok mb-4"><%= notice %></p><% end %>
<% if alert %><p id="alert" class="alert-err mb-4" role="alert"><%= alert %></p><% end %>
<div class="overflow-x-auto">
<table id="print_stations" class="table-console whitespace-nowrap">
  <thead><tr><th>名前</th><th>状態</th><th>最後の通信</th><th>バージョン</th><th>テスト印刷</th><th></th></tr></thead>
  <tbody>
    <% @stations.each do |s| %>
      <tr id="print_station_<%= s.id %>">
        <td class="font-bold"><%= s.name %></td>
        <td><%= s.revoked? ? status_pill("失効", :neutral) : (s.online? ? status_pill("オンライン", :ok) : status_pill("オフライン", :ng)) %></td>
        <td class="whitespace-nowrap"><%= s.last_seen_at ? l(s.last_seen_at.in_time_zone, format: :short) : "まだありません" %></td>
        <td><%= s.agent_version.presence || "—" %></td>
        <td class="whitespace-normal min-w-72"><%= render "test_print", station: s %></td>
        <td class="flex flex-nowrap items-center gap-2">
          <%# トークンの画面は 200 で直接返す（URL に残さない）。Turbo は 200 の POST 応答を捨てるので、Turbo を切って通常の送信にする。確認ダイアログは onsubmit で出す %>
          <%= button_to "再発行", reissue_admin_print_station_path(s), class: "btn-secondary btn-sm", form: { data: { turbo: false }, onsubmit: "return confirm('新しいトークンを発行します。古いトークンはすぐ使えなくなります。よろしいですか？')" } %>
          <% unless s.revoked? %>
            <%= button_to "失効", revoke_admin_print_station_path(s), class: "btn-danger btn-sm", data: { turbo_confirm: "トークンを失効します。このステーションは印刷できなくなります。よろしいですか？" } %>
          <% end %>
          <%= button_to "削除", admin_print_station_path(s), method: :delete, class: "btn-danger btn-sm", data: { turbo_confirm: "「#{s.name}」を削除します。元に戻せません。よろしいですか？" } %>
        </td>
      </tr>
    <% end %>
    <% if @stations.empty? %><tr><td colspan="6" class="text-center text-text-sub">ステーションはまだありません</td></tr><% end %>
  </tbody>
</table>
</div>
