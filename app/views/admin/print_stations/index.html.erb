<% content_for :title, "印刷ステーション" %>
<div class="flex items-center mb-6">
  <h1 class="page-title">印刷ステーション</h1>
  <%= link_to "ステーションを登録", new_admin_print_station_path, class: "btn-primary ml-auto" %>
</div>
<% if notice %><p id="notice" class="alert-ok mb-4"><%= notice %></p><% end %>
<% if alert %><p id="alert" class="alert-err mb-4" role="alert"><%= alert %></p><% end %>
<%# 6 列（%固定）。1200px 未満は 1 ステーション = 1 カードの縦積み。横スクロールは出さない %>
<table id="print_stations" class="station-table">
  <colgroup><col style="width:24%"><col style="width:20%"><col style="width:11%"><col style="width:11%"><col style="width:11%"><col style="width:23%"></colgroup>
  <thead><tr><th>名前</th><th>状態</th><th>トナー</th><th>用紙</th><th>バージョン</th><th>操作</th></tr></thead>
  <% @stations.each do |s| %>
    <% awaiting = !s.revoked? && !s.test_answered? && s.test_print_job&.acknowledged? %>
    <tbody id="print_station_<%= s.id %>" class="station" data-controller="toggle">
      <tr class="station-row">
        <td class="station-name font-bold" data-label="名前"><span class="truncate block" title="<%= s.name %>"><%= s.name %></span></td>
        <td data-label="状態"><%= s.revoked? ? status_pill("失効", :neutral) : (s.online? ? status_pill("オンライン", :ok) : status_pill("オフライン", :ng)) %>
          <p class="station-seen <%= "is-offline" unless s.revoked? || s.online? %>"><%= s.last_seen_at ? l(s.last_seen_at.in_time_zone, format: :short) : "まだ通信がありません" %></p>
          <% if s.heartbeat_lost? %><p id="heartbeat_lost_<%= s.id %>" class="mt-1 text-base font-bold text-err-fg">最後の通信から <%= s.minutes_since_seen %> 分。ハートビートが途絶えています。</p><% end %>
        </td>
        <td data-label="トナー"><%= s.revoked? ? "—" : supply_pill(s.toner_status) %></td>
        <td data-label="用紙"><%= s.revoked? ? "—" : supply_pill(s.paper_status) %></td>
        <td data-label="バージョン"><%= s.agent_version.presence || "—" %></td>
        <td class="station-actions" data-label="操作">
          <% unless s.revoked? %>
            <button type="button" class="btn-secondary btn-sm" data-toggle-target="button" data-action="toggle#toggle" aria-expanded="<%= awaiting %>" aria-controls="test_print_panel_<%= s.id %>">テスト印刷 ▾</button>
          <% end %>
          <%# トークンの画面は 200 で直接返す（URL に残さない）。Turbo は 200 の POST 応答を捨てるので、Turbo を切って通常の送信にする。確認ダイアログは onsubmit で出す %>
          <%= button_to "再発行", reissue_admin_print_station_path(s), class: "btn-secondary btn-sm", form: { data: { turbo: false }, onsubmit: "return confirm('新しいトークンを発行します。古いトークンはすぐ使えなくなります。よろしいですか？')" } %>
          <% unless s.revoked? %>
            <%= button_to "失効", revoke_admin_print_station_path(s), class: "btn-danger btn-sm", data: { turbo_confirm: "トークンを失効します。このステーションは印刷できなくなります。よろしいですか？" } %>
          <% end %>
          <% if s.deletable? %>
            <%= button_to "削除", admin_print_station_path(s), method: :delete, class: "btn-danger btn-sm", data: { turbo_confirm: "「#{s.name}」を削除します。テスト印刷のジョブも消えます。元に戻せません。よろしいですか？" } %>
          <% else %>
            <span class="caption w-full" id="undeletable_<%= s.id %>"><%= s.undeletable_reason %></span>
          <% end %>
        </td>
      </tr>
      <% unless s.revoked? %>
        <tr class="station-panel-row">
          <td colspan="6">
            <div id="test_print_panel_<%= s.id %>" class="station-panel" data-toggle-target="panel" <%= "hidden" unless awaiting %>>
              <%= render "test_print", station: s %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  <% end %>
  <% if @stations.empty? %><tbody><tr><td colspan="6" class="text-center text-text-sub">ステーションはまだありません</td></tr></tbody><% end %>
</table>
