<% content_for :title, "印刷ジョブ" %>
<div class="flex items-center mb-6">
  <h1 class="page-title">印刷ジョブ</h1>
  <%= link_to "印刷ジョブを作る", new_admin_print_job_path, class: "btn-primary ml-auto" %>
</div>
<p id="print-help" class="caption mb-4 max-w-3xl">小テストを刷るときは、小テストの印刷プレビューで「PDF として保存」し、「印刷ジョブを作る」でそのファイルをアップロードして、印刷ジョブを作成・実行します。サーバーで PDF を自動生成する方法は、当面は用意していません。</p>
<% if notice %><p id="notice" class="alert-ok mb-4"><%= notice %></p><% end %>
<% if alert %><p id="alert" class="alert-err mb-4" role="alert"><%= alert %></p><% end %>
<% if @problems.positive? %>
  <p id="problem-banner" class="alert-err mb-4" role="status">この 24 時間に、印刷できなかったジョブが <%= @problems %> 件あります（失敗または期限切れ）。
    <% if @only_problems %><%= link_to "すべて表示", admin_print_jobs_path, class: "link ml-2" %><% else %><%= link_to "失敗だけ表示", admin_print_jobs_path(problems: 1), class: "link ml-2" %><% end %></p>
<% end %>
<% if @waiting.positive? %>
  <p id="overdue-banner" class="alert-warn mb-4" role="status">予定時刻を過ぎても、まだ印刷されていないジョブが <%= @waiting %> 件あります。</p>
<% end %>
<% if @waiting.positive? && @offline_stations.any? %>
  <p id="offline-banner" class="alert-warn mb-4" role="status">
    オフラインのステーションがあります（<%= @offline_stations.map(&:name).join("、") %>）。待機中のジョブ <%= @waiting %> 件は、PC がつながるまで刷られません。
  </p>
<% end %>
<nav id="print_job_filters" class="flex flex-wrap items-center gap-2 mb-4" aria-label="印刷ジョブの絞り込み">
  <%= link_to "すべて", admin_print_jobs_path, class: "btn-sm #{@filter.nil? && !@only_problems ? 'btn-primary' : 'btn-secondary'}" %>
  <% @filters.each do |key, label| %>
    <%= link_to "#{label}（#{@filter_counts[key.to_sym]}）", admin_print_jobs_path(filter: key), class: "btn-sm #{@filter == key ? 'btn-primary' : 'btn-secondary'}" %>
  <% end %>
</nav>
<div class="overflow-x-auto">
<table id="print_jobs" class="table-console [&_td]:px-2 [&_th]:px-2">
  <thead><tr><th class="whitespace-nowrap">PDF / ステーション</th><th class="whitespace-nowrap">予定・締め切り</th><th class="whitespace-nowrap">状態</th><th></th></tr></thead>
  <tbody>
    <% @jobs.each do |j| %>
      <tr id="print_job_<%= j.id %>">
        <td class="min-w-40">
          <span class="font-bold"><%= j.title %></span>
          <p class="caption"><%= j.print_station.name %>　<%= j.copies %>部<%= j.staple.present? && j.staple != "なし" ? "（ホチキス#{j.staple}）" : "" %><%= j.duplex.present? ? "　#{duplex_label(j.duplex)}" : "" %></p>
        </td>
        <td class="whitespace-nowrap"><%= l j.scheduled_at.in_time_zone, format: :short %><p class="caption">〜 <%= j.expires_at.in_time_zone.to_date == j.scheduled_at.in_time_zone.to_date ? l(j.expires_at.in_time_zone, format: "%H:%M") : l(j.expires_at.in_time_zone, format: :short) %></p></td>
        <td>
          <%= print_job_pill(j) %>
          <% if (error = j.last_error) %><p id="print_job_error_<%= j.id %>" class="mt-1 w-40 text-base font-bold text-err-fg"><%= error %></p><% end %>
          <% if j.overdue_pending? %><p id="print_job_overdue_<%= j.id %>" class="mt-1 w-40 text-base font-bold text-warn-fg">予定時刻を過ぎても印刷されていません</p><% end %>
          <% if j.heartbeat_lost? %><p id="print_job_heartbeat_lost_<%= j.id %>" class="mt-1 w-40 text-base font-bold text-err-fg">ステーションのハートビートが途絶えています<% if j.last_heartbeat_at %>（最後の通信 <%= l j.last_heartbeat_at.in_time_zone, format: :short %>）<% end %></p><% end %>
        </td>
        <td>
          <div class="flex flex-nowrap items-center gap-1.5">
            <% if j.pending? %><%= button_to "今すぐ印刷", print_now_admin_print_job_path(j), class: "btn-secondary btn-sm whitespace-nowrap" %><% end %>
            <% unless j.finished? %><%= button_to "取り消す", cancel_admin_print_job_path(j), class: "btn-danger btn-sm whitespace-nowrap", data: { turbo_confirm: "このジョブを取り消します。よろしいですか？" } %><% end %>
          </div>
        </td>
      </tr>
    <% end %>
    <% if @jobs.empty? %><tr><td colspan="4" class="text-center text-text-sub"><%= @filter ? "「#{@filters[@filter]}」に該当するジョブはありません" : (@only_problems ? "失敗・期限切れのジョブはありません" : "印刷ジョブはありません") %></td></tr><% end %>
  </tbody>
</table>
</div>
