<% content_for :title, "ユーザーを招待" %>
<h1 class="page-title mb-6">ユーザーを招待</h1>
<%= form_with model: @user, url: admin_users_path, class: "space-y-4 max-w-md" do |f| %>
  <% if @user.errors.any? %>
    <div id="error_explanation" class="py-2 px-3 bg-err-bg text-err-fg rounded-lg"><ul><% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>
  <div><%= f.label :name, "氏名", class: "label" %><%= f.text_field :name, required: true, class: "input mt-1" %></div>
  <div><%= f.label :email_address, "メールアドレス", class: "label" %><%= f.email_field :email_address, required: true, class: "input mt-1" %></div>
  <div><%= f.label :role, "権限", class: "label" %><%= f.select :role, User.roles.keys.map { |r| [ t("roles.#{r}"), r ] }, {}, class: "input mt-1" %></div>
  <p class="text-lg text-text-sub">招待メールのリンクから、本人が初期パスワードを設定します（7日間有効）。</p>
  <%= f.submit "招待メールを送る", class: "btn-primary cursor-pointer" %>
<% end %>
