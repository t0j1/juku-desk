<% content_for :title, "マーキング検出" %>
<div class="flex flex-wrap items-center gap-3 mb-6">
  <h1 class="page-title mr-auto">教材画像を取り込む</h1>
  <%= link_to "取り込み済みの一覧", uploads_path, class: "btn-secondary" %>
</div>
<p class="mb-6 text-lg text-text-sub max-w-[640px]">赤枠でマーキングした教材の画像（JPEG / PNG）を選ぶと、赤枠の領域を自動で見つけます。長辺 <%= @config[:maxLongSide] %>px に縮小した画像と、切り出した領域だけがサーバーに送られます。見つからない・ずれている場合は、プレビューで直したり、領域を追加できます。</p>

<div data-controller="marking" data-marking-config-value="<%= @config.to_json %>" data-marking-url-value="<%= uploads_path %>">
  <label data-marking-target="drop" data-action="dragover->marking#dragover dragleave->marking#dragleave drop->marking#drop"
         class="flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-field-border bg-surface p-8 text-center cursor-pointer data-[dragging=true]:border-primary data-[dragging=true]:bg-run-bg">
    <%= console_icon(:upload) %>
    <span class="font-bold">ここに画像をドラッグ＆ドロップ、またはクリックして選ぶ</span>
    <span class="text-lg text-text-sub">JPEG / PNG・複数枚OK</span>
    <input type="file" id="marking-files" multiple accept="image/jpeg,image/png" class="sr-only" data-marking-target="input" data-action="change->marking#pick">
  </label>

  <div data-marking-target="items" class="mt-8 space-y-8"></div>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <button type="button" class="btn-primary !h-12" data-marking-target="confirm" data-action="marking#confirmAll" disabled>確定して保存</button>
    <p role="status" data-marking-target="status" class="text-lg font-bold text-text-sub"></p>
  </div>

  <template data-marking-target="itemTemplate">
    <section class="rounded-2xl border border-row-line p-4" data-item>
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <h2 class="font-bold mr-auto" data-name></h2>
        <p class="text-lg text-text-sub" data-state></p>
      </div>
      <div class="flex flex-col gap-4 lg:flex-row">
        <div class="relative self-start select-none touch-none max-w-full lg:basis-2/3">
          <img data-image alt="取り込む画像のプレビュー" class="block max-w-full h-auto" draggable="false">
          <div data-overlay class="absolute inset-0 cursor-crosshair"></div>
        </div>
        <div class="min-w-0 lg:basis-1/3">
          <p class="mb-2 text-lg text-text-sub" data-empty hidden>領域がありません。画像の上をドラッグするか「領域を追加」で囲んでください。</p>
          <ul class="space-y-2" data-regions></ul>
          <button type="button" class="btn-secondary mt-3" data-add><%= console_icon(:plus) %>領域を追加</button>
        </div>
      </div>
    </section>
  </template>

  <template data-marking-target="rowTemplate">
    <li class="rounded-xl bg-surface p-3" data-region-row>
      <div class="flex items-center gap-2 mb-2">
        <span class="font-bold" data-number></span>
        <span class="text-base text-text-sub" data-source></span>
        <button type="button" class="btn-danger ml-auto" data-delete>削除</button>
      </div>
      <div class="grid grid-cols-4 gap-2 text-base text-text-sub">
        <% { "x" => "左", "y" => "上", "w" => "幅", "h" => "高さ" }.each do |key, label| %>
          <label class="block"><%= label %><input type="number" min="0" class="input !h-9 !px-2 mt-1 tnum" data-field="<%= key %>"></label>
        <% end %>
      </div>
    </li>
  </template>
</div>
