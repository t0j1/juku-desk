<% content_for :title, "マーキング検出 ##{@upload.id}" %>
<div class="flex flex-wrap items-center gap-3 mb-6">
  <h1 class="page-title mr-auto">取り込んだ画像 #<%= @upload.id %></h1>
  <%= link_to "問題のレビュー", questions_path, class: "btn-secondary" %>
  <%= link_to "一覧に戻る", uploads_path, class: "btn-secondary" %>
</div>
<% if notice %><p id="notice" class="mb-4 text-lg font-bold text-ok-fg"><%= notice %></p><% end %>
<% if alert %><p id="alert" class="mb-4 text-lg font-bold text-err-fg"><%= alert %></p><% end %>
<div class="mb-4 flex flex-wrap items-center gap-3">
  <p id="extraction-status" class="text-lg font-bold">構造化：<%= Upload::EXTRACTION_LABELS.fetch(@upload.extraction_status) %></p>
  <% if current_user.can_write? && (@regions.any? { |r| CropRegion::RETRYABLE_STATUSES.include?(r.status) } || (@regions.any?(&:queued?) && !JobProgress.active.exists?(kind: "marking_structure", subject: @upload))) %>
    <%= form_with url: extract_upload_path(@upload), method: :post, class: "flex flex-wrap items-center gap-3" do |f| %>
      <label class="flex items-center gap-1 text-lg"><%= f.hidden_field :generate_answers, value: "0", id: nil %><%= f.check_box :generate_answers, { checked: true, id: "generate_answers" }, "1", nil %>教材に解答が無いときは AI で解答を作る</label>
      <%= f.submit "構造化を開始・やり直す", class: "btn-secondary cursor-pointer" %>
    <% end %>
  <% end %>
</div>
<div class="flex flex-col gap-6 lg:flex-row">
  <div class="relative self-start max-w-full lg:basis-2/3">
    <img src="<%= image_upload_path(@upload) %>" alt="取り込んだ画像" class="block max-w-full h-auto">
    <% @regions.each_with_index do |region, i| %>
      <% b = region.bbox %>
      <div class="absolute border-2 border-err-fg bg-err-fg/10" data-region-box="<%= region.id %>"
           style="left: <%= (b["x"].to_f / @upload.width * 100).round(3) %>%; top: <%= (b["y"].to_f / @upload.height * 100).round(3) %>%; width: <%= (b["w"].to_f / @upload.width * 100).round(3) %>%; height: <%= (b["h"].to_f / @upload.height * 100).round(3) %>%;">
        <span class="absolute -top-6 left-0 rounded bg-err-fg px-1.5 text-base font-bold text-white"><%= i + 1 %></span>
      </div>
    <% end %>
  </div>
  <ul id="regions" class="min-w-0 space-y-3 lg:basis-1/3">
    <% @regions.each_with_index do |region, i| %>
      <li class="rounded-xl bg-surface p-3" id="region_<%= region.id %>">
        <p class="font-bold mb-2">領域 <%= i + 1 %> <span class="text-base font-normal text-text-sub"><%= t("crop_region_status.#{region.status}", default: region.status) %><%= region.confidence ? "・自動 #{(region.confidence * 100).round}%" : "・手動" %></span></p>
        <img src="<%= image_crop_region_path(region) %>" alt="領域 <%= i + 1 %> の切り出し" loading="lazy" class="max-w-full h-auto rounded">
        <% if region.error_message.present? %><p class="mt-1 text-base text-err-fg"><%= region.error_message %></p><% end %>
        <% if %w[extracted needs_review].include?(region.status) %>
          <% region.questions.each do |q| %><p class="mt-1 text-lg" data-question="<%= q.id %>"><%= q.source_label %> <% if q.type_label %><span class="text-base text-text-sub">[<%= q.type_label %>]</span> <% end %><% if q.ai_answer? %><span class="text-base font-bold text-err-fg">AI作成</span> <% end %><%= link_to truncate(q.question_text, length: 40), edit_question_path(q), class: "underline" %></p><% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
