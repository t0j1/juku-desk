<% content_for :head do %><%= stylesheet_link_tag "katex/katex" %><% end %>
<% content_for :title, @test.title %>
<div class="flex flex-wrap items-center gap-3 mb-6">
  <h1 class="page-title mr-auto"><%= @test.title %></h1>
  <%= link_to "問題用を印刷", print_marking_test_path(@test, kind: "question"), target: "_blank", rel: "noopener", class: "btn-primary" %>
  <%= link_to "解答用を印刷", print_marking_test_path(@test, kind: "answer"), target: "_blank", rel: "noopener", class: "btn-primary" %>
  <%= link_to "作成済みの小テスト", marking_tests_path, class: "btn-secondary" %>
</div>
<% if @test.short? %>
  <div id="shortfall" class="mb-4 rounded-xl border border-err-fg bg-err-bg p-4 text-lg text-err-fg font-bold">
    条件に合う承認済みの問題が足りないため、<%= @test.requested_count %> 問のうち <%= @items.size %> 問で作成しました（<%= @test.shortfall %> 問不足）。
  </div>
<% end %>
<p class="mb-4 text-lg text-text-sub">印刷画面でブラウザの印刷を開き、「PDF として保存」もできます（用紙は A4、余白 15mm）。</p>
<% if @test.sectioned? %>
  <div id="test-sections" class="space-y-5">
    <% @items.chunk_while { |a, b| a.section == b.section }.each do |group| %>
      <section id="test_section_<%= group.first.section %>" class="test-section">
        <h2 class="text-lg font-bold mb-2"><span class="section-no">【<%= group.first.section %>】</span><%= @instructions[group.first.question_type] %></h2>
        <ol class="space-y-3">
          <% group.each do |item| %>
            <li id="test_item_<%= item.position %>" class="rounded-xl border border-row-line bg-bg p-3">
              <span class="tnum font-bold mr-2"><%= item.number_label %></span><span class="whitespace-pre-wrap" data-controller="math"><%= item.question.question_text %></span>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>
  </div>
<% else %>
<ol id="test-items" class="space-y-3">
  <% @items.each do |item| %>
    <li id="test_item_<%= item.position %>" class="rounded-xl border border-row-line bg-bg p-3">
      <span class="tnum font-bold mr-2"><%= item.position %></span><span class="whitespace-pre-wrap" data-controller="math"><%= item.question.question_text %></span>
    </li>
  <% end %>
</ol>
<% end %>
