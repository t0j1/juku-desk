<% subjects = @test.subject || @items.map { |i| i.question.subject }.compact.uniq.join("・") %>
<% content_for :title, "#{@test.title}（#{@kind == :answer ? "解答用" : "問題用"}）" %>
<% content_for :head do %>
  <style>
    @page { size: A4 portrait; margin: 15mm; @bottom-center { content: counter(page) " / " counter(pages); font-family: var(--marking-font); font-size: 9pt; } }
  </style>
  <%= stylesheet_link_tag "katex/katex" %>
<% end %>
<div data-controller="page-print print-options" class="marking-print">
  <div id="print-toolbar" class="card !py-4 flex flex-wrap items-center gap-3 mb-6 print:hidden">
    <button type="button" class="btn-primary" data-action="page-print#print"><%= console_icon(:printer) %>印刷</button>
    <%= link_to "もう一方（#{@kind == :answer ? "問題用" : "解答用"}）", print_marking_test_path(@test, kind: @kind == :answer ? "question" : "answer"), class: "btn-secondary" %>
    <%= link_to "戻る", marking_test_path(@test), class: "btn-secondary" %>
    <span class="caption">印刷ダイアログで「PDF として保存」もできます。</span>
    <div id="print-options" class="flex flex-wrap items-center gap-3 w-full">
      <label class="flex items-center gap-1"><span class="caption">解答欄の広さ</span>
        <select class="input !w-auto" data-print-options-target="size" data-action="print-options#apply" aria-label="解答欄の広さ">
          <option value="narrow">狭い</option><option value="normal" selected>ふつう</option><option value="wide">広い</option><option value="none">線なし</option>
        </select></label>
      <label class="flex items-center gap-1"><span class="caption">ページ内の配置</span>
        <select class="input !w-auto" data-print-options-target="layout" data-action="print-options#apply" aria-label="ページ内の配置">
          <option value="top" selected>上詰め</option><option value="even">ページ内に等間隔</option><option value="count">1ページあたりの問題数を指定</option>
        </select></label>
      <label class="flex items-center gap-1"><span class="caption">小問番号</span>
        <select class="input !w-auto" data-print-options-target="numbering" data-action="print-options#apply" aria-label="小問番号">
          <option value="original" selected>元のまま</option><option value="per">大問ごとに(1)から振り直す</option><option value="cont">通しで(1)から振り直す</option>
        </select></label>
      <label class="flex items-center gap-1" data-print-options-target="countField" hidden><span class="caption">問題数</span>
        <input type="number" min="1" max="30" value="5" class="input !w-20" data-print-options-target="count" data-action="input->print-options#apply" aria-label="1ページあたりの問題数"></label>
      <span class="caption">この画面を開いている間だけ有効です（保存されません）。</span>
    </div>
    <% if current_user.system_admin? %>
      <% stations = PrintStation.active.order(:name).to_a %>
      <% if stations.any? %>
        <%= form_with url: print_job_marking_test_path(@test), scope: :print_job, class: "flex flex-wrap items-center gap-3 w-full" do |f| %>
          <%= hidden_field_tag :kind, @kind %>
          <%= f.select :print_station_id, stations.map { |s| [ "#{s.name}#{"（オフライン）" unless s.online?}", s.id ] }, {}, class: "input !w-auto", "aria-label": "ステーション" %>
          <%= f.number_field :copies, min: 1, max: 99, value: 1, class: "input !w-24", "aria-label": "部数" %>
          <label class="flex items-center gap-1"><span class="caption">印刷する時刻</span><%= f.datetime_field :scheduled_at, value: Time.current.strftime("%Y-%m-%dT%H:%M"), class: "input !w-auto", "aria-label": "印刷する時刻" %></label>
          <label class="flex items-center gap-1"><span class="caption">締め切り</span><%= f.datetime_field :expires_at, class: "input !w-auto", "aria-label": "締め切り（空なら 2 時間後）" %></label>
          <label class="flex items-center gap-1"><span class="caption">小問番号</span><%= f.select :sub_numbers, [ [ "元のまま", "original" ], [ "大問ごとに(1)から振り直す", "per" ], [ "通しで(1)から振り直す", "cont" ] ], {}, class: "input !w-auto", "aria-label": "小問番号（PDF）" %></label>
          <%= driver_preset_select "print_job", blank_label: "（ステーションの既定を使う）", input_class: "input" %>
          <%= f.submit "印刷ジョブを作成", class: "btn-primary cursor-pointer" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <article class="mt-sheet" data-controller="math" data-print-options-target="sheet" data-answer-size="normal">
    <header class="mt-head">
      <div class="mt-title"><%= @test.title %><span class="mt-kind"><%= @kind == :answer ? "【解答】" : "" %></span></div>
      <div class="mt-meta">
        <span>科目：<%= subjects.presence || "—" %></span>
        <span>作成日：<%= @test.created_at.strftime("%Y年%-m月%-d日") %></span>
        <% if @kind == :question %><span>名前：<span class="mt-name-line"></span></span><% end %>
      </div>
    </header>
    <% if @test.short? %><p class="mt-short print:hidden">※ 問題が足りないため <%= @items.size %> 問で作成されています。</p><% end %>
    <% if @test.sectioned? %>
      <% @items.chunk_while { |a, b| a.section == b.section }.each do |group| %>
        <section class="mt-section" id="print_section_<%= group.first.section %>">
          <h2 class="mt-section-head"><span class="mt-section-no">【<%= group.first.section %>】</span><%= @instructions[group.first.question_type] %></h2>
          <ol class="mt-list">
            <% group.each do |item| %><%= render "print_item", item: item %><% end %>
          </ol>
        </section>
      <% end %>
    <% else %>
      <ol class="mt-list">
        <% @items.each do |item| %><%= render "print_item", item: item %><% end %>
      </ol>
    <% end %>
  </article>
</div>
