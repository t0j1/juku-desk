<% content_for :title, "作成済みの小テスト（マーキング）" %>
<div class="flex flex-wrap items-center gap-3 mb-6">
  <h1 class="page-title mr-auto">作成済みの小テスト</h1>
  <%= link_to "小テストを出題する", new_marking_test_path, class: "btn-primary" %>
</div>
<table id="marking-tests" class="table-console">
  <thead><tr><th>タイトル</th><th>出題方法</th><th>科目</th><th>問題数</th><th>作成日</th></tr></thead>
  <tbody>
    <% @tests.each do |t| %>
      <tr id="marking_test_<%= t.id %>">
        <td class="font-bold"><%= link_to t.title, marking_test_path(t), class: "underline" %></td>
        <td><%= t.mode == "by_tag" ? "タグ別" : "ランダム" %></td>
        <td><%= t.subject || "すべて" %></td>
        <td class="tnum"><%= t.items.size %><% if t.short? %> <span class="text-err-fg text-base">（<%= t.shortfall %> 問不足）</span><% end %></td>
        <td class="tnum"><%= t.created_at.strftime("%Y年%-m月%-d日") %></td>
      </tr>
    <% end %>
    <% if @tests.empty? %><tr><td colspan="5" class="text-center text-text-sub">まだ作成されていません</td></tr><% end %>
  </tbody>
</table>
