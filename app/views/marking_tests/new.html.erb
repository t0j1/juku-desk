<% content_for :title, "小テストの出題（マーキング）" %>
<div class="flex flex-wrap items-center gap-3 mb-6">
  <h1 class="page-title mr-auto">小テストの出題（承認済みの問題から）</h1>
  <%= link_to "作成済みの小テスト", marking_tests_path, class: "btn-secondary" %>
  <%= link_to "問題のレビュー", questions_path, class: "btn-secondary" %>
</div>
<p class="mb-4 text-lg text-text-sub">出題の対象は<strong>承認済みの問題</strong>だけです（現在 <span id="approved-count" class="tnum font-bold"><%= @approved_count %></span> 問）。</p>
<%= form_with model: @builder, scope: :marking_test, url: marking_tests_path, class: "space-y-4 max-w-xl" do |f| %>
  <% if @builder.errors.any? %>
    <div id="error_explanation" class="py-2 px-3 bg-err-bg text-err-fg rounded-lg"><ul><% @builder.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>
  <div><%= f.label :title, "タイトル", class: "label" %><%= f.text_field :title, class: "input mt-1", maxlength: 100 %></div>
  <div>
    <%= f.label :mode, "出題方法", class: "label" %>
    <%= f.select :mode, [ [ "ランダム", "random" ], [ "タグ別", "by_tag" ] ], {}, class: "input mt-1" %>
  </div>
  <div><%= f.label :count, "問題数", class: "label" %><%= f.number_field :count, min: 1, max: Marking::QuestionPicker.max_count, class: "input mt-1 !w-32" %></div>
  <div><%= f.label :subject, "科目", class: "label" %><%= f.select :subject, Question::SUBJECTS, { include_blank: "すべて" }, class: "input mt-1 !w-48" %></div>
  <div><%= f.label :tags_text, "タグ（スペースかカンマ区切り。タグ別のときは必須）", class: "label" %><%= f.text_field :tags_text, class: "input mt-1" %></div>
  <div>
    <%= f.label :tag_logic, "タグの条件", class: "label" %>
    <%= f.select :tag_logic, [ [ "どれか 1 つでも含む（OR）", "or" ], [ "すべて含む（AND）", "and" ] ], {}, class: "input mt-1 !w-64" %>
  </div>
  <div class="flex items-end gap-3">
    <div><%= f.label :difficulty_min, "難易度（下限）", class: "label" %><%= f.select :difficulty_min, (1..5).to_a, { include_blank: "指定なし" }, class: "input mt-1 !w-32" %></div>
    <div><%= f.label :difficulty_max, "難易度（上限）", class: "label" %><%= f.select :difficulty_max, (1..5).to_a, { include_blank: "指定なし" }, class: "input mt-1 !w-32" %></div>
  </div>
  <fieldset id="group-by-type" class="rounded-xl border border-row-line p-3" data-controller="type-order">
    <label class="flex items-center gap-2 text-lg font-bold">
      <%= f.check_box :group_by_type, data: { type_order_target: "toggle", action: "type-order#toggled" } %>形式ごとに並べる（大問【1】・小問(1)の番号を振る）
    </label>
    <div data-type-order-target="panel" class="mt-3">
      <p class="text-base text-text-sub mb-2">大問の順番（上から【1】【2】…。選んだ問題に無い形式は飛ばします）。指示文は<%= link_to "大問の指示文", section_templates_path, class: "underline" %>で編集できます。</p>
      <%= f.hidden_field :type_order, data: { type_order_target: "input" } %>
      <ol id="type-order" data-type-order-target="list" class="space-y-1">
        <% @builder.type_order_list.each do |t| %>
          <li data-type="<%= t %>" id="type_order_<%= t %>" class="flex items-center gap-2">
            <span class="tnum w-6 text-right" data-order-no></span>
            <span class="w-28 font-bold"><%= Question::TYPE_LABELS[t] %></span>
            <button type="button" class="btn-secondary !h-9 !px-3" data-action="type-order#up" aria-label="<%= Question::TYPE_LABELS[t] %>を上へ">上へ</button>
            <button type="button" class="btn-secondary !h-9 !px-3" data-action="type-order#down" aria-label="<%= Question::TYPE_LABELS[t] %>を下へ">下へ</button>
          </li>
        <% end %>
      </ol>
    </div>
  </fieldset>
  <p class="text-base text-text-sub">条件に合う問題が足りないときは、ある分だけで作成します（別の条件の問題では補いません）。</p>
  <% if current_user.can_write? %><%= f.submit "小テストを作成", class: "btn-primary cursor-pointer" %><% end %>
<% end %>
