<%# ページ遷移・フォーム送信が遅いときの読み込み表示（Turbo の遷移中）。画面中央のカード。body の差し替えで消えないよう permanent にする。0.4 秒未満は何も出さない %>
<div id="load-indicator" data-turbo-permanent data-controller="load-indicator" class="load-indicator print:hidden" data-state="idle" aria-busy="false" hidden>
  <div class="load-panel" role="status">
    <div class="load-band" aria-hidden="true"></div>
    <div class="load-body">
      <div class="load-icon" aria-hidden="true" data-load-indicator-target="icon">⟳</div>
      <p class="load-title">読み込み中…</p>
      <p class="load-elapsed" aria-hidden="true">（経過 <span data-load-indicator-target="seconds">0</span> 秒）</p>
      <p class="load-reason" data-load-indicator-target="reason" hidden>サーバーを起動しています（無料枠のため最大 1 分ほどかかります）</p>
      <div class="load-bar" aria-hidden="true"><div class="load-fill" data-load-indicator-target="fill"><div class="load-stripes"></div></div></div>
      <p class="load-estimate" data-load-indicator-target="estimate" hidden>所要時間は推定できません</p>
      <p class="load-slow" data-load-indicator-target="slow" hidden>時間がかかっています。<br>
        <button type="button" class="btn-secondary btn-sm mt-2" data-action="load-indicator#reload">再読み込み</button></p>
    </div>
  </div>
</div>
