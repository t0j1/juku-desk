<% content_for :title, "生徒データベース" %>
<div class="flex items-center">
  <h1 class="page-title">生徒データベース</h1>
  <% if current_user.can_write? %><%= link_to new_student_path, class: "btn-primary ml-auto" do %><%= console_icon(:plus) %>生徒を登録<% end %><% end %>
</div>
<% if @students.empty? && params[:weekday].blank? %>
  <div id="students-empty" class="card flex flex-col items-center justify-center py-16 text-center">
    <span class="flex items-center justify-center size-16 rounded-full bg-bg shadow-inset text-primary mb-4"><%= console_icon(:users, size: 32) %></span>
    <p class="text-text-sub mb-6">まだ生徒が登録されていません</p>
    <%= link_to new_student_path, class: "btn-secondary" do %><%= console_icon(:plus) %>生徒を登録<% end %>
  </div>
<% else %>
<div class="card">
  <div class="mb-5 flex flex-wrap gap-3" role="group" aria-label="通い曜日で絞り込み">
    <% seg = ->(on) { "inline-flex items-center h-10 px-5 rounded-pill text-lg #{on ? 'bg-bg shadow-inset text-primary font-bold' : 'bg-bg shadow-raise-sm text-text hover:text-primary'}" } %>
    <%= link_to "全員", students_path, class: seg.(params[:weekday].blank?), aria: { pressed: params[:weekday].blank? } %>
    <% StudentWeekday::NAMES.each_with_index do |n, i| %>
      <%= link_to n, students_path(weekday: i), class: seg.(params[:weekday] == i.to_s), aria: { pressed: params[:weekday] == i.to_s } %>
    <% end %>
  </div>
  <table id="students" class="table-console">
    <thead>
      <tr><th>氏名</th><th>学年</th><th>通い曜日</th><th>状態</th></tr>
    </thead>
    <tbody>
      <% @students.each do |student| %>
        <tr>
          <td><%= link_to student.name, student, class: "font-bold text-text hover:text-primary hover:underline" %></td>
          <td><%= student.grade %></td>
          <td><%= student.student_weekdays.map(&:label).join("・") %></td>
          <td><%= student.left_on ? status_pill("退塾（#{l student.left_on}）", :neutral) : status_pill("在籍", :ok) %></td>
        </tr>
      <% end %>
      <% if @students.empty? %><tr><td colspan="4" class="text-center text-text-sub">該当する生徒はいません</td></tr><% end %>
    </tbody>
  </table>
</div>
<% end %>
