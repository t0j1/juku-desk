<% content_for :title, "生徒データベース" %>
<div class="flex items-center mb-6">
  <h1 class="font-bold text-[22px]">生徒データベース</h1>
  <%= link_to new_student_path, class: "btn-primary ml-auto" do %><%= console_icon(:plus) %>生徒を登録<% end %>
</div>
<div class="mb-6 flex flex-wrap gap-2 text-sm" role="group" aria-label="通い曜日で絞り込み">
  <% seg = ->(on) { "inline-flex items-center h-9 px-4 rounded-full border #{on ? 'bg-primary border-primary text-white font-bold' : 'bg-white border-line-strong text-ink hover:border-primary'}" } %>
  <%= link_to "全員", students_path, class: seg.(params[:weekday].blank?), aria: { pressed: params[:weekday].blank? } %>
  <% StudentWeekday::NAMES.each_with_index do |n, i| %>
    <%= link_to n, students_path(weekday: i), class: seg.(params[:weekday] == i.to_s), aria: { pressed: params[:weekday] == i.to_s } %>
  <% end %>
</div>
<% if @students.empty? && params[:weekday].blank? %>
  <div id="students-empty" class="flex flex-col items-center justify-center py-16 text-center">
    <span class="flex items-center justify-center size-16 rounded-full bg-busy-bg text-primary mb-4"><%= console_icon(:users, size: 32) %></span>
    <p class="text-ink-sub mb-6">まだ生徒が登録されていません</p>
    <%= link_to new_student_path, class: "btn-primary" do %><%= console_icon(:plus) %>生徒を登録<% end %>
  </div>
<% else %>
<table id="students" class="table-console">
  <thead>
    <tr><th>氏名</th><th>学年</th><th>通い曜日</th><th>状態</th></tr>
  </thead>
  <tbody>
    <% @students.each do |student| %>
      <tr>
        <td><%= link_to student.name, student, class: "font-bold text-ink hover:text-primary hover:underline" %></td>
        <td><%= student.grade %></td>
        <td><%= student.student_weekdays.map(&:label).join("・") %></td>
        <td><%= student.left_on ? status_pill("退塾（#{l student.left_on}）", :neutral) : status_pill("在籍", :ok) %></td>
      </tr>
    <% end %>
    <% if @students.empty? %><tr><td colspan="4" class="text-center text-ink-sub">該当する生徒はいません</td></tr><% end %>
  </tbody>
</table>
<% end %>
